# ==============================================================================
# Company Lead Tracker — Environment Configuration Template
# Copy this file to .env.local and update with your actual configuration.
# DO NOT commit .env.local to version control.
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String
# Example for local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/company_lead_tracker
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/company_lead_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/company_lead_tracker

# JWT Secret for Session Signing (minimum 32 characters required)
JWT_SECRET=your_long_random_jwt_secret_key_at_least_32_characters_here

# Public Base URL for Generating Embed Links and iframe Codes
# Defaults to http://localhost:3000 in development, or your production domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reverse Proxy Trust Configuration
# Set TRUST_PROXY=true if running behind a reverse proxy (Nginx, Cloudflare, AWS ALB, Vercel)
# This enables accurate client IP resolution for rate limiting from headers (cf-connecting-ip, x-real-ip, x-forwarded-for)
TRUST_PROXY=false

# Number of trusted reverse proxy hops (defaults to 1 if TRUST_PROXY=true)
TRUST_PROXY_HOPS=1

# Optional: Initial Super Admin bootstrap credentials (used by `npm run bootstrap:admin`)
# SUPER_ADMIN_NAME="Platform Administrator"
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
